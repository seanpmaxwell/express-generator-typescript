{
  "name": "express-generator-typescript",
  "version": "2.8.1",
  "description": "Generate new Express applications similar to express-generate which but sets it up to use TypeScript instead",
  "scripts": {
    "commit": "npm run format && git add -A && git commit -m \"dev commit\"",
    "commit:push": "npm run commit && git push",
    "install:clean": "rm -rf node_modules && rm -rf package-lock.json && npm i",
    "prepack": "npm run readme:swap",
    "postpack": "npm run readme:restore",
    "readme:swap": "node scripts/readme.js swap",
    "readme:restore": "node scripts/readme.js restore",
    "typecheck": "tsc"
  },
  "main": "lib/cli.js",
  "bin": {
    "express-generator-typescript": "bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanpmaxwell/express-generator-typescript.git"
  },
  "keywords": [
    "express",
    "express-generator",
    "express-generator-typescript",
    "typescript",
    "typescript-express",
    "api",
    "rest",
    "rest-api",
    "scaffold",
    "scaffolding",
    "cli",
    "generator",
    "nodejs",
    "backend",
    "boilerplate",
    "starter",
    "template",
    "express-ts",
    "server",
    "tooling"
  ],
  "author": "sean maxwell",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seanpmaxwell/express-generator-typescript/issues"
  },
  "homepage": "https://github.com/seanpmaxwell/express-generator-typescript#readme",
  "dependencies": {
    "dts-bundle-generator": "^9.5.1",
    "edit-json-file": "^1.7.0",
    "esbuild": "^0.28.2",
    "ncp": "^2.0.0",
    "jet-logger": "3.0.0"
  }
}
