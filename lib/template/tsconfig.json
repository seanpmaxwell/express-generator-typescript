{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@src/*": ["./src/*"]
    },
    // tsx transpiles one file at a time, so type-only imports must say so
    "verbatimModuleSyntax": true,
    "useUnknownInCatchVariables": false,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "eslint.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/public/*"]
}
