{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Resolve "#src/*" (package.json "imports") to the .ts sources
    "customConditions": ["development"],
    // Node runs the .ts files directly, so imports name them; the build
    // rewrites relative ".ts" imports to ".js"
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Node strips types one file at a time, so type-only imports must say so
    // and syntax that needs compiling (enums, namespaces...) isn't allowed
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "useUnknownInCatchVariables": false,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "eslint.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/public/*"]
}
