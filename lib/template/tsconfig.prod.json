{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "strict": true,
    "rootDir": "./src",
    "outDir": "dist",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // "#src/*" imports stay as-is in dist/ and resolve to dist/*.js at runtime
    // through package.json "imports"
    "customConditions": ["development"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "useUnknownInCatchVariables": false,
    "types": ["node"],
    "sourceMap": false,
    "removeComments": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/public/"]
}
