{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "strict": true,
    "rootDir": "./src",
    "outDir": "dist",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@src/*": ["./src/*"]
    },
    "verbatimModuleSyntax": true,
    "useUnknownInCatchVariables": false,
    "types": ["node"],
    "sourceMap": false,
    "removeComments": true
  },
  // After tsc, tsc-alias rewrites "@src/..." imports in dist/ to relative
  // paths and adds the ".js" extensions Node's ESM loader requires (source
  // imports are written without extensions)
  "tsc-alias": {
    "resolveFullPaths": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/public/"]
}
